lmht {
    posicao-deslocamento: 20% centro;
    limite-forma-imagem: 0.9;
    espaçamento-letras: .2rem;
    area-mascara: completar-caixa, preenchimento;
    coluna-em-grade: auto / auto;
}

lmht {
    posicao-direita: 20%;
    configuracoes-variacao-fonte: 10;
    cor-barra-rolagem: rgb(10, 20, 30);
}

lmht {
    cor-barra-rolagem: #ffffff;
}

lmht {
    cor-barra-rolagem: verde;
}

lmht {
    borda-direita: 20%;
}

lmht {
    fonte-texto: "Arial";
}

lmht {
    agrupar-palavra: normal;
    ao-mudar: auto;
}
